# Copy to .env and edit.  Do not commit .env.
# No credential, endpoint or model identifier belongs in the repository.

# ---------------------------------------------------------------- runtime
COMPLIANCE_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WORKER_METRICS_PORT=9101
SERVICE_NAME=compliance-api

# ---------------------------------------------------------------- storage
REDIS_URL=redis://redis:6379/0
INDEX_DIR=/data/index
CORPUS_FILE=/app/corpus/provisions.jsonl
PROMPTS_DIR=/app/prompts
PROMPT_VARIANT=v2
INDEX_MANIFEST=/app/corpus/sources/MANIFEST.json

# ---------------------------------------------------------------- retrieval
# hashing = deterministic local feature hashing, no model download (default)
# sentence_transformers = optional local MiniLM, install requirements-ml.txt
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
EMBEDDING_MODEL=your-local-embedding-model
CHUNK_MAX_CHARS=1100
CHUNK_OVERLAP_CHARS=120
RETRIEVAL_TOP_K=6
RETRIEVAL_VECTOR_WEIGHT=0.62
RETRIEVAL_LEXICAL_WEIGHT=0.38
RETRIEVAL_CACHE_TTL_S=900

# ---------------------------------------------------------------- agents
MAX_STEPS=12
MAX_TOOL_CALLS=10
MAX_WALL_CLOCK_S=30
MAX_VERIFY_LOOPS=2
MAX_LLM_CALLS=6

# ---------------------------------------------------------------- provider
# stub_local: in-process deterministic client, no network, zero cost.
# stub_http:  call the stub service (used for load tests).
# openai_compatible: any OpenAI-compatible endpoint; fill URL/key/model below.
LLM_PROVIDER=stub_local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_S=0.25
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_S=30
# Example accounting rates.  Set to your provider's published rates.
LLM_INPUT_COST_PER_MTOK=0.15
LLM_OUTPUT_COST_PER_MTOK=0.60

# ---------------------------------------------------------------- guardrails
INJECTION_MODE=quarantine          # quarantine | sanitise
TOXICITY_MODE=quarantine           # quarantine | sanitise
ENABLE_OUTPUT_FILTER=true
ENABLE_DEMO_ENDPOINTS=true

# ---------------------------------------------------------------- reliability
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RUN_CACHE_ENABLED=true
AUTO_EVAL_SAMPLE_RATE=0.2
QUEUE_STREAM=compliance:runs
QUEUE_GROUP=workers
QUEUE_CONSUMER_PREFIX=worker
RUN_TTL_S=604800
QUARANTINE_DIR=/data/quarantine

# ---------------------------------------------------------------- telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_MULTIPROC_DIR=

# ---------------------------------------------------------------- SLO (declared before measurement)
SLO_P95_MS=20000
SLO_TARGET_RPS=2

# ---------------------------------------------------------------- stub provider
STUB_LLM_DELAY_MS=150
STUB_LLM_FAIL_RATE=0.0
